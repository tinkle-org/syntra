# Local tooling and OS metadata — never published to tinklehq/syntra
.agents/
.opencode/
.DS_Store
**/.DS_Store

# Build outputs (forthcoming Rust reference / conformance)
target/
dist/
*.log

# Reproducible schema tooling outputs (baselines under compatibility are tracked)
# Committed generated types live in the tree and ARE tracked:
#   crates/**/src/generated/*.rs (Rust prost output, drift-checked)
#   bindings/go/**/*.pb.go (Go protobuf output, drift-checked)
# See scripts/validate-schema.py (committed-generation model) and the
# repository-boundary validator. Disposable smoke-test / packaging output
# below is never committed (boundary check fails if .tmp/ is tracked).
.tmp/
.tools/
__pycache__/

# Editor
.vscode/
.idea/
*.swp
